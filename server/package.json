{
  "name": "earphone-wire-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --inspector-ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/cloudflare-shim.mjs scripts/test-worker.ts",
    "test:mcp": "node scripts/test-mcp.mjs",
    "inspector": "npx --yes @modelcontextprotocol/inspector@2.0.0 --server-url http://localhost:8787/mcp --transport http"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  }
}
