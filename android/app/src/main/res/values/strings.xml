    <string name="review_access">Review Notification Listener access</string>
    <string name="access_explanation">Android provides active media sessions after you enable this notification listener. Earphone Wire reads QQ Music MediaSession metadata and playback state only. It does not read notification text. When paired, it uploads only the latest valid QQ Music snapshot over HTTPS.</string>
    <string name="result_section_title">QQ Music media session</string>
