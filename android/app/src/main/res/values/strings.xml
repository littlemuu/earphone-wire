    <string name="app_name">耳机线</string>
    <string name="listener_service_name">耳机线媒体会话访问</string>
    <string name="stage_label">第三关 B：安全中继配对</string>
    <string name="app_heading">QQ 音乐中继</string>
    <string name="app_intro">完成配对后，耳机线会通过 HTTPS 向你的私有 Worker 上传当前 QQ 音乐的歌名、歌手、播放状态和观察时间；不会上传通知正文，也不会建立播放历史。</string>
    <string name="access_section_title">系统访问权限</string>
    <string name="access_enabled">通知使用权已开启</string>
    <string name="access_disabled">需要开启通知使用权</string>
    <string name="grant_access">开启通知使用权</string>
    <string name="review_access">查看通知使用权</string>
    <string name="access_explanation">开启通知使用权后，Android 会提供活跃媒体会话。耳机线只读取 QQ 音乐 MediaSession 的元数据和播放状态，不读取通知文字。完成配对后，只会经 HTTPS 上传最新且有效的 QQ 音乐快照。</string>
