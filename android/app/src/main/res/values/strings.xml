    <string name="app_heading">QQ Music relay</string>
    <string name="app_intro">After pairing, Earphone Wire uploads the current QQ Music title, artist, playback state, and observation time to your private Worker over HTTPS. It never uploads notification bodies and does not build playback history.</string>
